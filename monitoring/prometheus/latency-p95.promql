# 95th percentile latency of /work in seconds, over 5 minutes.
# Run in: Prometheus explorer of the Azure Monitor workspace pp-dev-amw.
# Reads: http_request_duration_seconds_bucket (labels route, le).
histogram_quantile(
  0.95,
  sum by (le) (rate(http_request_duration_seconds_bucket{route="/work"}[5m]))
)
