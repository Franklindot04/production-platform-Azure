// /work requests slower than the threshold, newest first.
// Change thresholdMs to set the limit, in milliseconds.
// Run in: Logs view of the Log Analytics workspace pp-dev-law or of Application Insights.
// Reads: AppRequests. The request name includes the method.
let thresholdMs = 500;
AppRequests
| where Name == "GET /work"
| where DurationMs > thresholdMs
| project TimeGenerated, Name, ResultCode, DurationMs, OperationId
| order by TimeGenerated desc
